---
// Homepage = primary GBP category (Pest control service) + Port Moresby.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { site, img800, waLink } from '../data/site';
import { areas } from '../data/areas';
import { faqs } from '../data/faqs';

const why = [
  { t: 'Pest control and fumigation', d: 'General pest control, container and commodity fumigation, artifacts and handicrafts, termites, fogging and disinfection, all from one company.' },
  { t: 'Homes to warehouses', d: 'We work in houses and flats, hotels, restaurants, shops, offices, warehouses, industrial sites and agricultural storage.' },
  { t: 'Based at 6 Mile', d: 'Our office is at the 6 Mile Incubation Center & Open Market on Saraga St. Drop off carvings for fumigation or come in to talk about a job.' },
  { t: 'Across PNG', d: 'Port Moresby first, plus Lae, Mt. Hagen and jobs nationwide.' },
];
const pests = ['Cockroaches', 'Ants', 'Termites', 'Rats & mice', 'Mosquitoes', 'Flies', 'Bed bugs', 'Fleas', 'Ticks', 'Wood borers', 'Beetles', 'Weevils', 'Moths'];
---
<Base
  title="Pest Control & Fumigation in Port Moresby | Bismarck Pest"
  description="Pest control and fumigation in Port Moresby: cockroaches, termites, rats, containers, artifacts and handicrafts. Lae, Mt. Hagen and PNG-wide. +675 7654 3386."
>
  <PageHero big eyebrow="Port Moresby · Lae · Mt. Hagen · Nationwide" title="Pest Control & Fumigation in Port Moresby" sub="General pest control, termite treatment and fumigation of containers, export goods, artifacts and handicrafts for homes and businesses across Papua New Guinea." chips={['Free quotes', 'Homes & businesses', 'Mon–Sat 8:30am–4:30pm']} />

  <section class="section">
    <div class="container grid grid-2">
      <div>
        <span class="eyebrow">Who we are</span>
        <h2 class="section-title">Port Moresby’s Pest Control & Fumigation Team</h2>
        <div class="answer"><p>{site.description}</p></div>
        <p class="pad">Cockroaches in the kitchen, termites in the posts, rats in the ceiling, a container that has to be treated before it sails, or carvings you want to take home overseas: tell us what you are dealing with and we will tell you exactly how we would treat it and what it costs.</p>
        <div class="btn-row">
          <a class="btn btn--red" href={`tel:${site.phoneIntl}`}>Call {site.phone}</a>
          {waLink() && <a class="btn btn--outline" href={waLink()} rel="noopener">WhatsApp Us</a>}
        </div>
      </div>
      <figure class="photo pic"><img src={img800('placeholder')} alt="Timothy Thomas of Bismarck Pest Management in Port Moresby" width="800" height="600" loading="lazy" /></figure>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h2 class="section-title">What We Do</h2>
      <div class="mt"><ServiceCards /></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Pests we treat</span>
      <h2 class="section-title">The Pests We Deal With Every Week</h2>
      <p class="lead">PNG’s warm, humid climate keeps pests breeding all year. These are the ones we treat in homes, businesses and stored goods.</p>
      <ul class="pests">{pests.map((p) => <li>{p}</li>)}</ul>
      <p class="mt">See <a href="/general-pest-control/">general pest control</a> for household and business pests, <a href="/termite-control/">termite control</a> for termites, and <a href="/fumigation-services/">fumigation</a> for wood borers, beetles, weevils and moths in goods and timber.</p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <span class="eyebrow">Why choose us</span>
      <h2 class="section-title">Why People Call Bismarck</h2>
      <div class="grid grid-4 mt">{why.map((w) => <div class="card"><h3>{w.t}</h3><p>{w.d}</p></div>)}</div>
    </div>
  </section>

  <Steps dark />

  <section class="section">
    <div class="container">
      <span class="eyebrow">Service areas</span>
      <h2 class="section-title">Where We Work</h2>
      <p class="lead">Based at 6 Mile in Port Moresby, serving {site.serviceArea}.</p>
      <ul class="areas"><li><a href="/">Port Moresby</a></li>{areas.map((a) => <li><a href={`/service-areas/${a.slug}/`}>{a.name}</a></li>)}<li><a href="/service-areas/">Nationwide</a></li></ul>
    </div>
  </section>

  <Faq faqs={faqs.slice(0, 6)} />
  <CtaBand />
</Base>

<style>
  .pad { margin: 22px 0 26px; }
  .pic { margin: 0; aspect-ratio: 4 / 3; }
  .mt { margin-top: 30px; }
  .pests { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .pests li { background: var(--paper); border: 1px solid var(--line); border-left: 4px solid var(--red); border-radius: var(--radius); padding: 8px 16px; font-family: var(--head); font-weight: 700; font-size: 20px; text-transform: uppercase; color: var(--ink); }
  .areas { list-style: none; padding: 0; margin: 20px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px 20px; }
  .areas a { font-family: var(--head); font-weight: 700; font-size: 21px; text-transform: uppercase; color: var(--ink); text-decoration: none; border-bottom: 2px solid var(--red); }
</style>
