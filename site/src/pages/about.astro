---
// About page: the owner's real story builds trust and gives AI assistants the facts they need.
// Use real names, real years, real photos. Add Person schema for the owner if they want to be named.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, img800 } from '../data/site';
import { breadcrumbs } from '../data/schema';
const crumbs = [{ name: 'About', href: '/about/' }];
const person = { '@context': 'https://schema.org', '@type': 'Person', name: site.owner, jobTitle: 'Owner', image: `${site.url}/images/photos/timothy-thomas-owner-bismarck-pest-management.webp`, worksFor: { '@id': `${site.url}/#business` }, sameAs: ['https://pg.linkedin.com/in/timothy-t-thomas-40089a1b2'] };
const about = { '@context': 'https://schema.org', '@type': 'AboutPage', name: `About ${site.shortName}`, url: `${site.url}/about/`, about: { '@id': `${site.url}/#business` } };
---
<Base title={`About ${site.shortName} | Port Moresby, PNG`} description={`About ${site.shortName}: Port Moresby pest control and fumigation company owned by Timothy Thomas, serving Lae, Mt. Hagen and all of PNG.`} schema={[breadcrumbs(crumbs), about, person]}>
  <PageHero eyebrow="About us" title="About Bismarck Pest Management" sub="A Port Moresby pest control and fumigation company working across PNG." crumbs={crumbs} />
  <section class="section">
    <div class="container grid grid-2">
      <div>
        <div class="answer"><p>{site.description}</p></div>
        <div class="copy">
          <p>Bismarck Pest Management is owned by Timothy Thomas and runs from the 6 Mile Incubation Center & Open Market on Saraga St in Port Moresby. From there we look after homes, businesses and exporters in Port Moresby, Lae, Mt. Hagen and right across Papua New Guinea.</p>
          <p>Our work covers the pests that matter in PNG: cockroaches, ants, termites, rats and mice, mosquitoes, flies, bed bugs, fleas, ticks, wood borers, beetles, weevils and moths. We fumigate shipping containers, import and export commodities, artifacts and handicrafts, treat soil for termites before and after construction, fog and mist for mosquitoes and flies, and carry out public health disinfection.</p>
          <p>Bismarck Pest Management Ltd was registered with the IPA in May 2021, and in July 2021 NAQIA approved us to conduct Eco2fume phosphine fumigation for biosecurity and pre-shipment purposes (registration ECOPG0099). Timothy is one of the company’s accredited fumigators.</p>
          <p>We work in houses and flats, and in hotels, restaurants, shops, offices, warehouses, industrial sites and agricultural storage. Whatever the job, we explain what the treatment is, what you need to do, and what it costs before we start.</p>
        </div>
      </div>
      <figure class="photo pic"><img src={img800('timothy-thomas-owner-bismarck-pest-management')} alt="Timothy Thomas, owner of Bismarck Pest Management, Port Moresby" width="720" height="720" loading="lazy" /><figcaption>Timothy Thomas, owner</figcaption></figure>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .copy { margin-top: 24px; }
  .pic { margin: 0; aspect-ratio: 1 / 1; }
  .pic figcaption { font-size: 15px; color: var(--muted); padding-top: 8px; }
</style>
