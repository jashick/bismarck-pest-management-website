---
// Loom or YouTube embed with VideoObject schema. Video facts live in `videos` in src/data/site.ts.
// Emit the schema once per page (schema={false} on repeat uses).
import { videos, site } from '../data/site';
interface Props { id: string; schema?: boolean; }
const { id, schema = true } = Astro.props;
const v = videos[id];
const vertical = v?.ratio === '9/16';
const obj = v && {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: v.title,
  description: v.description,
  thumbnailUrl: v.thumbnail,
  uploadDate: v.uploadDate,
  duration: v.duration,
  embedUrl: v.embedUrl,
  publisher: { '@id': `${site.url}/#business` },
};
---
{v && (
  <figure class:list={['vid', { 'vid--vertical': vertical }]}>
    <div class="vid__frame" style={`aspect-ratio:${v.ratio}`}>
      <iframe src={v.embedUrl} title={v.title} loading="lazy" allow="fullscreen" allowfullscreen></iframe>
    </div>
    {v.caption && <figcaption>{v.caption}</figcaption>}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(obj)} />}
  </figure>
)}

<style>
  .vid { margin: 0 auto; width: 100%; }
  .vid--vertical { max-width: 330px; }
  .vid__frame { position: relative; border-radius: 12px; overflow: hidden; background: var(--ink); box-shadow: 0 18px 40px rgba(0,0,0,.22); }
  .vid--vertical .vid__frame { border: 6px solid var(--ink); }
  .vid__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .vid figcaption { text-align: center; font-size: 15px; color: var(--muted); margin-top: 10px; }
</style>
