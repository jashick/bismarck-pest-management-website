# Apache (SiteGround) settings. TODO: set the domain in the https/www rule, and add a 301 for every
# old URL from the previous site (check Google Search Console > Pages and the old sitemap).
RewriteEngine On

# Force https + www (match site.url)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^bismarckpest\.com$ [NC]
RewriteRule ^(.*)$ https://www.bismarckpest.com/$1 [R=301,L]

# Old WordPress URLs (examples; edit to match the old site)
RewriteRule ^contact-us/?$ /get-a-quote/ [R=301,L]
RewriteRule ^feed/?.*$ / [R=301,L]
RewriteRule ^wp-login\.php$ / [R=301,L]
RewriteRule ^wp-admin/?.*$ / [R=301,L]
RewriteRule ^xmlrpc\.php$ / [R=301,L]
RewriteRule ^(author|category|tag)/.*$ / [R=301,L]
RewriteRule ^(sitemap\.xml|sitemap_index\.xml|page-sitemap\.xml|post-sitemap\.xml)$ /sitemap-index.xml [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
